# aviationstack API key (https://aviationstack.com/dashboard)
AVIATIONSTACK_API_KEY=your_api_key_here
# Only if your plan does not include HTTPS (free plan):
# AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1

# Local PostgreSQL started by docker-compose.yml
POSTGRES_DB=flights
POSTGRES_USER=flights
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://flights:change_me@127.0.0.1:5432/flights
